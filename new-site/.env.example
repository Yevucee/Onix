# =============================================================================
# Onix Website — Environment Variables
# Copy to .env (local) or .env.staging (staging). NEVER commit secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — all environments
# -----------------------------------------------------------------------------

# development | staging | production
SITE_ENV=development

# PostgreSQL connection string
# Local:  postgresql://onix:onix@localhost:5432/onix
# Docker: postgresql://onix:onix@postgres:5432/onix
# Staging: postgresql://onix_staging:SECRET@postgres:5432/onix_staging
DATABASE_URL=postgresql://onix:onix@localhost:5432/onix

# Payload encryption secret — generate 32+ random characters (REQUIRED)
PAYLOAD_SECRET=

# Public site URL — no trailing slash (REQUIRED)
# Staging example: https://staging.onixdatacentres.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# STAGING_ONLY — private review environment
# -----------------------------------------------------------------------------

# HTTP Basic Auth (middleware) — REQUIRED for staging
STAGING_AUTH_USER=
STAGING_AUTH_PASSWORD=

# Do not send contact emails to production recipients on staging (default: suppressed)
STAGING_SEND_EMAIL=false

# Staging admin bootstrap (scripts/staging/create-admin.ts) — set before first run
STAGING_ADMIN_EMAIL=
STAGING_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# PRODUCTION_ONLY — enable only at launch
# -----------------------------------------------------------------------------

# Contact form recipient
CONTACT_FORM_RECIPIENT=

# Email provider: log | resend
EMAIL_PROVIDER=log
EMAIL_API_KEY=
EMAIL_FROM=noreply@onixdatacentres.com

# Newsletter provider: log | mailchimp | etc.
NEWSLETTER_PROVIDER=log
NEWSLETTER_API_KEY=

# Google Analytics 4 — do NOT set on staging
GA4_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# OPTIONAL
# -----------------------------------------------------------------------------

# Local media storage path (persistent volume in Docker)
MEDIA_STORAGE_PATH=./media

# WordPress export for migration scripts (path from new-site/)
WP_EXPORT_PATH=../migration/source/wordpress/onixdatacentre.WordPress.2026-08-07.xml

# Extracted uploads directory (gitignored .migration-work/)
UPLOADS_EXTRACT_DIR=../.migration-work

# Staging QA crawl target (scripts/staging/qa-crawl.ts)
STAGING_BASE_URL=http://localhost:3000
