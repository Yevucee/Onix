# Environment: development | staging | production
SITE_ENV=development

# PostgreSQL connection string
# Docker Compose: postgresql://onix:onix@postgres:5432/onix
# Local Postgres: postgresql://onix:onix@localhost:5432/onix
DATABASE_URL=postgresql://onix:onix@localhost:5432/onix

# Payload encryption secret (generate a random 32+ char string)
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: staging HTTP basic auth (when host supports it)
# STAGING_BASIC_AUTH_USER=
# STAGING_BASIC_AUTH_PASSWORD=

# Media storage (local path inside container / persistent volume)
MEDIA_STORAGE_PATH=./media

# WordPress export path for migration scripts (relative to repo root)
WP_EXPORT_PATH=../migration/source/wordpress/onixdatacentre.WordPress.2026-08-07.xml
