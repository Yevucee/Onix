{
  "name": "onix-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "import:article": "tsx scripts/import-article.ts",
    "import:article:report": "tsx scripts/import-article.ts --report",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "media:inventory": "tsx scripts/media-inventory.ts",
    "migrate:validate-uploads": "tsx scripts/migrate/validate-uploads.ts",
    "migrate:reconcile-media": "tsx scripts/migrate/reconcile-media.ts",
    "migrate:analyze-derivatives": "tsx scripts/migrate/analyze-derivatives.ts",
    "migrate:scope-media": "tsx scripts/migrate/scope-media.ts",
    "migrate:media": "tsx scripts/migrate/import-media.ts",
    "migrate:articles": "tsx scripts/migrate/import-articles.ts",
    "migrate:articles:all": "tsx scripts/migrate/import-articles.ts --all",
    "migrate:articles:sample": "tsx scripts/migrate/import-articles.ts --sample",
    "migrate:leadership": "tsx scripts/migrate/import-leadership.ts",
    "migrate:redirects": "tsx scripts/migrate/import-redirects.ts",
    "migrate:pages": "tsx scripts/migrate/import-pages.ts",
    "migrate:articles:resolve": "tsx scripts/migrate/import-articles.ts --all",
    "migrate:verify": "tsx scripts/migrate/verify.ts",
    "phase4:qa": "tsx scripts/phase4/qa.ts",
    "phase6:seed-group1": "tsx scripts/phase6/seed-group1-content.ts",
    "phase6:leadership-photos": "tsx scripts/migrate/import-leadership-photos.ts",
    "phase6:group1-staging": "tsx scripts/phase6/group1-staging.ts",
    "phase6:visual-qa": "tsx scripts/visual-audit/group1-qa.ts",
    "staging:migrate": "tsx scripts/staging/migrate-all.ts",
    "staging:admin": "tsx scripts/staging/create-admin.ts",
    "staging:reconcile": "tsx scripts/staging/reconcile-content.ts",
    "staging:crawl": "tsx scripts/staging/qa-crawl.ts",
    "staging:legacy-urls": "tsx scripts/staging/legacy-url-check.ts",
    "staging:article-warnings": "tsx scripts/staging/article-warnings-final.ts",
    "staging:indexing-test": "tsx scripts/staging/indexing-test.ts",
    "staging:verify": "tsx scripts/staging/indexing-test.ts && tsx scripts/staging/qa-crawl.ts && tsx scripts/staging/legacy-url-check.ts",
    "staging:qa-reports": "tsx scripts/staging/generate-qa-reports.ts",
    "seed": "tsx scripts/seed-prototype.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.87.1",
    "@payloadcms/next": "3.87.1",
    "@payloadcms/richtext-lexical": "3.87.1",
    "@payloadcms/ui": "3.87.1",
    "cheerio": "^1.2.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^5.2.5",
    "graphql": "^16.10.0",
    "next": "15.4.11",
    "node-html-parser": "^9.0.1",
    "payload": "3.87.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.27.0",
    "eslint-config-next": "15.4.11",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
